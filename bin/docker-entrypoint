#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
  LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
  export LD_PRELOAD
fi

# Migrate and seed before the server starts, as the Heroku-style release
# phase did (lib/tasks/release.rake).
if [ "${@: -4:1}" == "./bin/rails" ] && [ "${@: -3:1}" == "server" ] || [ "$1" == "./bin/rails" ] && [ "$2" == "server" ]; then
  ./bin/rails release
fi

exec "${@}"
